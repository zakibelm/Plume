# Plume — Environment Variables Template
# Copy to .env and fill in actual values. NEVER commit .env.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ─── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://plume.example.com

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/app/logs

# ─── Budget Defaults ─────────────────────────────────────────────────────────
DEFAULT_MAX_COST_USD=2.00
DEFAULT_MAX_LLM_CALLS=60

# ─── LLM Settings ────────────────────────────────────────────────────────────
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
